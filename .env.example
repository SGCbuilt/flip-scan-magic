VITE_ANTHROPIC_API_KEY=your_anthropic_key_here
# FlipScan Pro — Environment Variables
# Copy this file to .env and fill in your values
# In Lovable: Settings → Environment Variables

# RentCast API — Required for Deal Scanner, comps, AVM, market data
# Get key at: app.rentcast.io/app/api-keys
VITE_RENTCAST_KEY=your_rentcast_key_here

# Supabase — Required for cloud sync and edge functions
# Auto-set by Lovable when you connect Supabase in Settings → Integrations
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# All other keys (Anthropic, Tracerfy, PostGrid) are set in-app via Settings tab
